{
  "name": "parseopts-ts",
  "version": "1.0.0",
  "description": "Tiny zero-dependency TypeScript argv parser: typed options, aliases, negatable booleans, arrays, choices, stop-at-positional, and `--` terminator.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --verbose",
    "test:coverage": "jest --coverage --verbose",
    "typecheck": "tsc --noEmit",
    "pretest": "node --test dependency-audit.test.cjs"
  },
  "keywords": [
    "argv",
    "argparse",
    "argument-parser",
    "cli",
    "command-line",
    "getopt",
    "options",
    "flags",
    "minimist",
    "typescript",
    "zero-dependency"
  ],
  "author": "Nripanka Das <nripankadas@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nripankadas07/parseopts-ts.git"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "js-yaml": {
      "argparse": "2.0.1"
    }
  }
}
